# ---------- App ----------
# development | production | test
NODE_ENV=production
PORT=4141
# Public URL of this backend (used for building file/media links)
HOSTED_BACKEND_URL=https://backend.example.com
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# ---------- Database (PostgreSQL) ----------
DATABASE_URL="postgresql://username:password@localhost:5432/dbname?schema=public"

# ---------- Auth / JWT ----------
JWT_SECRET=change_me_jwt_secret
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10
BCRYPT_SALT_ROUNDS=10

# ---------- SOP integration ----------
SOP_URL=https://sop.example.com
SOP_JWT_SECRET=change_me_sop_secret

# ---------- Super admin (seed) ----------
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change_me_password

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=no-reply@example.com

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_SECRET_KEY=your_api_secret

# ---------- AWS ----------
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=ap-south-1

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
