# Backend API base URL (must end with /api/v1)
# Local:      http://localhost:4141/api/v1
# Production: https://backend.medcodeninja.com/api/v1
VITE_SERVER_URL=http://localhost:4141/api/v1

# WebSocket server URL (ws:// or wss://)
VITE_WS_SERVER_URL=ws://localhost:4141

# Optional: pin the public website to one institute (defaults to the first institute)
VITE_PUBLIC_ADMIN_ID=
